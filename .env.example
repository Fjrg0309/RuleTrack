# ──────────────────────────────────────────────────────────────────────────────
# RuleTrack — Variables de entorno
# Copia este archivo como .env y rellena los valores antes de ejecutar Docker.
# NUNCA subas el archivo .env al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de datos (local) ──────────────────────────────────────────────────────
DB_USERNAME=ruletrack
DB_PASSWORD=ruletrack_password_segura

# ── Base de datos (DigitalOcean Managed PostgreSQL) ────────────────────────────
# Descomenta y rellena estas líneas para producción en DO:
# SPRING_DATASOURCE_URL=jdbc:postgresql://db-ruletrack-do-user-XXXXXXXX-0.e.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# DB_USERNAME=doadmin
# DB_PASSWORD=tu_password_de_do

# Secreto JWT (cambia esto en producción, mínimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-en-produccion-minimo-32-chars

# LLM (OpenAI o compatible, p. ej. Groq, Azure OpenAI, Ollama...)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...tu-api-key-aqui...
LLM_MODEL=gpt-4o

# URL interna del backend (usada por nginx para el proxy inverso)
# En Docker Compose con la red bridge, el nombre del servicio actúa como hostname
BACKEND_URL=http://ruletrack-backend:8080
